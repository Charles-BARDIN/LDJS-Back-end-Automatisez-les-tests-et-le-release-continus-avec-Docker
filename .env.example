# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Configuration
# Used directly when running the app against a local MongoDB (npm run start:dev)
MONGO_URI=mongodb://localhost:27017/workshopsdb

# MongoDB credentials (used by docker-compose for the MongoDB container
# and to build the authenticated MONGO_URI of the api service)
DB_USER=admin
DB_PASSWORD=password

# CORS Configuration
CORS_ORIGIN=http://localhost:5173
